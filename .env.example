# Copy to .env and fill in. Never commit the filled-in copy: .gitignore excludes
# .env and every .env.* variant, and this template is the one exception.

# Supabase project the backend reads and writes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Anthropic key the agent uses. Scope it to the least you need.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Deployments only. Set this and the two keys above are read from Google Secret
# Manager as the workload's own service account instead of from this file.
# ARGUS_SECRET_PROJECT=your-gcp-project
